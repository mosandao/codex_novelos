{
  "modules": [
    {
      "id": "channel-male",
      "file": "channel-male.md",
      "when": {
        "field": "setup.channel",
        "equals": "男频"
      }
    },
    {
      "id": "channel-female",
      "file": "channel-female.md",
      "when": {
        "field": "setup.channel",
        "equals": "女频"
      }
    },
    {
      "id": "channel-omni",
      "file": "channel-omni.md",
      "when": {
        "field": "setup.channel",
        "equals": "全向"
      }
    },
    {
      "id": "platform-free",
      "file": "platform-free.md",
      "when": {
        "field": "setup.platform_traits.model",
        "equals": "免费算法"
      }
    },
    {
      "id": "platform-paid",
      "file": "platform-paid.md",
      "when": {
        "field": "setup.platform_traits.model",
        "equals": "付费订阅"
      }
    },
    {
      "id": "reference-plot-frameworks",
      "file": "reference-plot-frameworks.md",
      "when": {
        "field": "setup.genre_profile",
        "non_empty": true
      }
    }
  ],
  "data_slots": [
    "project_setup",
    "persona_full",
    "upstream:direction",
    "genre_pack"
  ],
  "divergence": "expansive",
  "decision_scope": "propose_only"
}
