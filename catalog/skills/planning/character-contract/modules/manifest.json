{
  "modules": [
    {
      "id": "channel-male",
      "file": "channel-male.md",
      "when": {
        "field": "setup.channel",
        "equals": "男频"
      }
    },
    {
      "id": "channel-female",
      "file": "channel-female.md",
      "when": {
        "field": "setup.channel",
        "equals": "女频"
      }
    },
    {
      "id": "channel-omni",
      "file": "channel-omni.md",
      "when": {
        "field": "setup.channel",
        "equals": "全向"
      }
    },
    {
      "id": "genre-present",
      "file": "genre-present.md",
      "when": {
        "field": "setup.genre_profile",
        "not_null": true
      }
    },
    {
      "id": "reference-archetype-spectrum",
      "file": "reference-archetype-spectrum.md",
      "when": {
        "field": "setup.genre_profile",
        "non_empty": true
      }
    }
  ],
  "data_slots": [
    "kernel_full",
    "persona_full",
    "project_setup",
    "genre_pack",
    "upstream:architecture",
    "upstream:strategy",
    "upstream:world_contract"
  ],
  "divergence": "balanced",
  "decision_scope": "propose_only"
}
