      "when": {
        "field": "setup.channel",
        "equals": "男频"
      }
    },
    {
      "id": "channel-female",
      "file": "channel-female.md",
      "when": {
        "field": "setup.channel",
        "equals": "女频"
      }
    },
    {
      "id": "channel-omni",
      "file": "channel-omni.md",
      "when": {
        "field": "setup.channel",
        "equals": "全向"
      }
