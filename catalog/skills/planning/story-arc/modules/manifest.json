        "field": "setup.genre_profile",
        "non_empty": true
      }
    }
  ],
  "data_slots": [
    "project_setup",
    "persona_gate",
    "genre_pack",
    "book_soul",
    "mechanisms",
    "upstream:strategy",
    "upstream:character_contract",
    "upstream:world_contract"
