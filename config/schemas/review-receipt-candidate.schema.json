{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelos.local/schemas/review-receipt-candidate.schema.json",
  "title": "NovelOS Review Receipt 候选",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject_type",
    "subject_ref",
    "subject_hash",
    "verdict",
    "findings",
    "reviewer_profile",
    "evidence_refs"
  ],
  "properties": {
    "subject_type": {
      "type": "string",
      "enum": [
        "chapter",
        "continuity_candidate_set",
        "planning_asset",
        "entity_mutation",
        "planning_cross_check",
        "review_subject"
      ]
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "subject_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "verdict": {
      "type": "string",
      "enum": ["approved", "rejected"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "message", "evidence_refs"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["blocking", "warning", "note", "strength"]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string"
          },
          "issue_key": {
            "type": "string",
            "minLength": 1,
            "description": "R9 M10 稳定问题键：同一根因跨轮复用同一 key（指纹类用 fpr: 编号/FP 定位符，语义类用受控分类号如 STRUCT-climax-gap）——3 轮升级判「同因复发」的机器可比对锚点；缺省=主控语义判读"
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "defer_to_downstream": {
            "type": "string",
            "minLength": 1,
            "description": "下游豁免：warning 属下游执行责任时标注下游 asset_type"
          },
          "accepted_risk": {
            "type": "boolean",
            "description": "艺术风险豁免：warning 为有意创作取舍，经用户确认后豁免"
          },
          "accepted_by": {
            "type": "string",
            "minLength": 1,
            "description": "accepted_risk 的确认方（user）"
          }
        }
      }
    },
    "reviewer_profile": {
      "type": "string",
      "minLength": 1,
      "description": "审查者模型身份（防共谋机器留痕）：model:<provider:model>（异构厂商模型直审）或 agent:<name>@<model>（具名审查 agent）；裸字符串在落库门不合法"
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assessment": {
      "type": "object",
      "minProperties": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "subject_type": {"const": "review_subject"}
        },
        "required": ["subject_type"]
      },
      "then": {
        "required": ["assessment"]
      },
      "else": {
        "not": {
          "required": ["assessment"]
        }
      }
    }
  ]
}
