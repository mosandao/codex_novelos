{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelos.local/schemas/project-create-request.schema.json",
  "title": "NovelOS 项目创建请求（novelos.project.create.v3）",
  "description": "向导产出的提交 JSON 的结构契约。v3：creator 段（原型直连派生）已被 author_kernel 完全取代（Task 30 决策 2）。mode=create 首次建核（kernel_hints 六字段）；mode=select 绑定既有内核版本（库内反查）。词表级联与内核反查由插件 novelos_gate_entry 工具在 schema 之上追加校验。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_type",
    "setup"
  ],
  "properties": {
    "request_type": {
      "const": "novelos.project.create.v3"
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "author_kernel",
        "channel",
        "platform",
        "platform_traits",
        "scale",
        "primary_genre",
        "secondary_directions",
        "emotional_surface",
        "emotional_core",
        "tonal_contrast",
        "aesthetic_styles",
        "genre_profile",
        "reference_material"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "author_kernel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "kernel_hints"
          ],
          "properties": {
            "mode": {
              "enum": [
                "select",
                "create"
              ]
            },
            "kernel_version_id": {
              "type": "string",
              "pattern": "^creator-profile-version:[a-z0-9][a-z0-9-]*(:[0-9]+)?$"
            },
            "subject_hash": {
              "$ref": "#/$defs/hash"
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "kernel_hints": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 6,
              "properties": {
                "taste_anchors": {
                  "$ref": "#/$defs/line_list"
                },
                "people_and_scenes": {
                  "$ref": "#/$defs/line_list"
                },
                "hard_nos": {
                  "$ref": "#/$defs/line_list"
                },
                "obsessions": {
                  "$ref": "#/$defs/line_list"
                },
                "core_questions": {
                  "$ref": "#/$defs/line_list"
                },
                "knowledge_domains": {
                  "$ref": "#/$defs/line_list"
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "select"
                  }
                }
              },
              "then": {
                "required": [
                  "kernel_version_id",
                  "subject_hash"
                ]
              }
            }
          ]
        },
        "style_seed": {
          "type": "object",
          "additionalProperties": false,
          "description": "可选风格种子段。mode=persona_select 时走库内反查（主控自查，与 author_kernel select 同构且更严）：seed_version_id 存在 + 该 profile ownership='style_seed' + status='active' + seed_subject_hash 与该版本 subject_hash 相符。种子卡语义 = 表达层风格参照，不是 parent（parent 永远是内核版本）；种子与内核/表里基调根本相斥时须用户裁决，禁止静默硬融",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "none",
                "persona_select"
              ]
            },
            "seed_version_id": {
              "type": "string",
              "pattern": "^creator-profile-version:[a-z0-9][a-z0-9-]*(:[0-9]+)?$"
            },
            "seed_subject_hash": {
              "$ref": "#/$defs/hash"
            },
            "seed_display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "persona_select"
                  }
                }
              },
              "then": {
                "required": [
                  "seed_version_id",
                  "seed_subject_hash"
                ]
              }
            }
          ]
        },
        "channel": {
          "enum": [
            "男频",
            "女频",
            "全向"
          ]
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "platform_traits": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "patience": {
              "type": "string",
              "minLength": 1
            },
            "reader_profile": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "scale": {
          "enum": [
            "短篇（30万字以下）",
            "中篇（30-100万字）",
            "长篇（100-300万字）",
            "超长篇（300万字以上）"
          ]
        },
        "primary_genre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "secondary_directions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "emotional_surface": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "emotional_core": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "tonal_contrast": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "aesthetic_styles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "genre_profile": {
          "type": [
            "object",
            "null"
          ]
        },
        "reference_material": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 10000
        }
      }
    }
  },
  "$defs": {
    "line_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "maxItems": 20
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
