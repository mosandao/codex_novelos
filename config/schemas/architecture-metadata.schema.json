{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelos.local/schemas/architecture-metadata.schema.json",
  "title": "NovelOS 故事架构结构化产物",
  "description": "architecture 资产 metadata 的结构化机制清单 v1：机制注册表（含血缘双源与耦合规格）、主线密度声明（双层引擎的统合层参数）、单元弧粒度、双引擎油耗分级。供下游 strategy/volume_outline 精确引用与 validate --scale 机器门核验（油耗下限×档位、密度×档位、空窗上限×档位）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mechanisms", "mainline_density", "unit_arc", "engines"],
  "properties": {
    "schema_version": {"const": 1},
    "mechanisms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "description": "结构化机制清单：正文每个机制一条，孤岛（无耦合）在 schema 层即不合法",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sources", "rhythm", "downstream", "coupling"],
        "properties": {
          "name": {"$ref": "#/$defs/non_empty_text"},
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_type", "ref"],
              "properties": {
                "source_type": {
                  "type": "string",
                  "enum": ["direction_field", "persona_part", "genre_pack", "setup", "reference_material"]
                },
                "ref": {"$ref": "#/$defs/non_empty_text"}
              }
            }
          },
          "rhythm": {"$ref": "#/$defs/non_empty_text"},
          "downstream": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {"type": "string", "enum": ["strategy", "character_contract", "world_contract"]}
          },
          "coupling": {
            "type": "object",
            "additionalProperties": false,
            "required": ["form", "spec"],
            "properties": {
              "form": {
                "type": "string",
                "enum": ["io", "quota", "both"],
                "description": "io=机制间产出喂输入；quota=每 k 单元注入主线载荷；both=两者并存"
              },
              "spec": {"$ref": "#/$defs/non_empty_text"}
            }
          }
        }
      }
    },
    "mainline_density": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "beats_per_volume", "gap_limit_volumes", "burst_positions"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["高", "中", "低"],
          "description": "低=柯南/X档案形态：单元为主+主线稀疏爆发，合法但空窗须有上限与爆发点设计"
        },
        "beats_per_volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 6,
          "description": "每卷主线 beats 规划值（可为 0——低密度卷合法；tier 与该值一致性由 validate 核验）"
        },
        "gap_limit_volumes": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 6,
          "description": "主线空窗上限（卷）——validate --scale 对照档位上限（短篇1/中篇2/长篇3/超长篇4）"
        },
        "burst_positions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["卷首", "卷中", "卷尾", "按需"]}
        },
        "notes": {"$ref": "#/$defs/non_empty_text"}
      }
    },
    "unit_arc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_chapters", "max_chapters"],
      "properties": {
        "min_chapters": {"type": "integer", "minimum": 1, "maximum": 3},
        "max_chapters": {"type": "integer", "minimum": 1, "maximum": 12,
          "description": "单元弧章数上限：免费平台连载常规 2-5 章（连续 3 章无兑现即弃书风险），超限须在正文论证"}
      }
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "integrator"],
      "properties": {
        "production": {"$ref": "#/$defs/engine"},
        "integrator": {"$ref": "#/$defs/engine"}
      }
    }
  },
  "$defs": {
    "non_empty_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["escalation_levels"],
      "properties": {
        "escalation_levels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "油耗分级数——validate --scale 对照档位下限（短篇2/中长篇3/超长篇5），两级烧完撑不起规模"
        },
        "fuel": {"$ref": "#/$defs/non_empty_text"}
      }
    }
  }
}
