{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelos.local/schemas/book-soul.schema.json",
  "title": "NovelOS 书级创作灵魂",
  "description": "NovelOS 书级创作灵魂 v2：十三字段，含 organizing_principle（组织原则）、promise_cadence（承诺兑现节奏）与 power_currency（力量货币），下游 architecture/strategy 结构化依赖",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "organizing_principle",
    "central_contradiction",
    "promise_cadence",
    "power_currency",
    "unresolved_claims",
    "costly_commitments",
    "protected_dignity",
    "forbidden_resolutions",
    "recurring_tests",
    "narrative_mercy",
    "narrative_cruelty",
    "deliberate_silences"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "organizing_principle": {"$ref": "#/$defs/non_empty_text"},
    "central_contradiction": {"$ref": "#/$defs/non_empty_text"},
    "promise_cadence": {"$ref": "#/$defs/non_empty_text"},
    "power_currency": {"$ref": "#/$defs/non_empty_text"},
    "unresolved_claims": {"$ref": "#/$defs/non_empty_text_list"},
    "costly_commitments": {"$ref": "#/$defs/non_empty_text_list"},
    "protected_dignity": {"$ref": "#/$defs/non_empty_text_list"},
    "forbidden_resolutions": {"$ref": "#/$defs/non_empty_text_list"},
    "recurring_tests": {"$ref": "#/$defs/non_empty_text_list"},
    "narrative_mercy": {"$ref": "#/$defs/non_empty_text"},
    "narrative_cruelty": {"$ref": "#/$defs/non_empty_text"},
    "deliberate_silences": {"$ref": "#/$defs/non_empty_text_list"}
  },
  "$defs": {
    "non_empty_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "non_empty_text_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/non_empty_text"}
    }
  }
}
