{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelos.local/schemas/planning-candidate.schema.json",
  "title": "NovelOS 规划候选输出",
  "oneOf": [
    {
      "type": "string",
      "minLength": 1
    },
    {
      "title": "Agent 质量实验规划输出",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_type",
        "candidate",
        "upstream_fidelity",
        "evidence_and_impact",
        "ownership_boundary",
        "change_proposals"
      ],
      "properties": {
        "asset_type": {
          "type": "string",
          "minLength": 1
        },
        "candidate": {
          "type": "string",
          "minLength": 1
        },
        "upstream_fidelity": {
          "type": "string",
          "minLength": 1
        },
        "evidence_and_impact": {
          "type": "string",
          "minLength": 1
        },
        "ownership_boundary": {
          "type": "string",
          "minLength": 1
        },
        "change_proposals": {
          "type": "array"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "decision_points": {"type": "array"},
            "character_roster": {"$ref": "#/$defs/character_roster"},
            "volume_characters": {"$ref": "#/$defs/volume_characters"}
          }
        }
      }
    }
  ],
  "$defs": {
    "character_roster": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role_class", "arc_role", "登场卷", "预期退场"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 60},
          "role_class": {"enum": ["main", "secondary"]},
          "arc_role": {"type": "string", "minLength": 1, "maxLength": 200},
          "登场卷": {"type": "integer", "minimum": 1, "maximum": 99},
          "预期退场": {
            "enum": ["完成型", "迁移型", "转化型", "关系型", "功能转移型", "休眠型", "死亡型", "持续活跃"]
          }
        }
      }
    },
    "volume_characters": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role_class", "arc_role", "预期退场"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 60},
          "role_class": {"enum": ["secondary", "minor"]},
          "arc_role": {"type": "string", "minLength": 1, "maxLength": 200},
          "预期退场": {
            "enum": ["完成型", "迁移型", "转化型", "关系型", "功能转移型", "休眠型", "死亡型", "持续活跃"]
          },
          "微档案": {"type": "string", "maxLength": 200},
          "登记备注": {"type": "string", "maxLength": 200}
        }
      }
    }
  }
}
