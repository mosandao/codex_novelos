{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelos.local/schemas/creator-signature.schema.json",
  "title": "NovelOS 作者签名",
  "description": "v1 = 系统原型签名（无 persona）；v2 = 派生签名（persona 必填，先立人再落规）。v3 = v2 增量：可选 kernel_origin（内核层继承的可追溯锚点）+ 可选 style_dna（风格 DNA：corpus_basis 定级 + 语言/结构/标点/对话四列蒸馏）+ 可选 measured_features（逐特征豁免依据，fpr:/style: 双命名空间）。存量 v1/v2 签名不迁移不复验、继续合法（新字段全部可选，读侧防御式）；tier=D 时 measured_features 必须为空（无测量依据即无豁免）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sympathies",
    "distrusts",
    "recurring_attention",
    "narrative_principles",
    "forbidden_conveniences",
    "expression_preferences",
    "negative_constraints"
  ],
  "properties": {
    "schema_version": {"enum": [1, 2, 3]},
    "persona": {"$ref": "#/$defs/persona"},
    "kernel_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernel_version_id", "kernel_subject_hash"],
      "properties": {
        "kernel_version_id": {
          "type": "string",
          "pattern": "^creator-profile-version:[a-z0-9][a-z0-9-]*(:[0-9]+)?$"
        },
        "kernel_subject_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "adaptation_notes": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "sympathies": {"$ref": "#/$defs/non_empty_text_list"},
    "distrusts": {"$ref": "#/$defs/non_empty_text_list"},
    "recurring_attention": {"$ref": "#/$defs/non_empty_text_list"},
    "narrative_principles": {"$ref": "#/$defs/non_empty_text_list"},
    "forbidden_conveniences": {"$ref": "#/$defs/non_empty_text_list"},
    "expression_preferences": {"$ref": "#/$defs/non_empty_text_list"},
    "negative_constraints": {"$ref": "#/$defs/non_empty_text_list"},
    "style_dna": {"$ref": "#/$defs/style_dna"},
    "measured_features": {"$ref": "#/$defs/measured_feature_list"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 2}}},
      "then": {"required": ["persona"]}
    },
    {
      "if": {"properties": {"schema_version": {"const": 1}}},
      "then": {"not": {"required": ["persona"]}}
    },
    {
      "if": {
        "required": ["style_dna"],
        "properties": {
          "style_dna": {
            "properties": {"corpus_basis": {"required": ["tier"], "properties": {"tier": {"const": "D"}}}}
          }
        }
      },
      "then": {"properties": {"measured_features": {"maxItems": 0}}},
      "description": "红方 F12：tier=D（无语料无种子，无测量依据）→ measured_features 必须为空或缺省——无依据即无豁免"
    }
  ],
  "$defs": {
    "style_dna": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_basis"],
      "properties": {
        "corpus_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier"],
          "properties": {
            "tier": {
              "enum": ["A", "B", "C", "D"],
              "description": "A=用户自有语料（≥15 篇可信；≥5 篇可用，notes 须声明小样本折扣）；B=授权文本（notes 必须含可核验授权凭证，只蒸馏写法零内容搬运）；C=降级（库内种子卡在场/仅内核派生——无直接语料测量，四列表为推导缺省）；D=无（无语料无种子——风格侧显式留白，measured_features 必须为空）。组合来源主源在前写入 notes"
            },
            "notes": {
              "type": "string",
              "maxLength": 500,
              "description": "定级理由/组合声明/降级声明；B 级必填授权凭证；A 级 <15 篇必填小样本折扣声明；D 级必填「本签名无测量依据，指纹豁免不可用」"
            },
            "refs": {
              "type": "array",
              "maxItems": 20,
              "items": {"type": "string", "minLength": 1, "maxLength": 200},
              "description": "依据锚点：resource:stylecorpus:xxx / styleseed 种子卡 resource id / 授权声明标识；tier=D 时空数组"
            }
          }
        },
        "lexicon_summary": {
          "type": "string",
          "maxLength": 400,
          "description": "口头禅/高频意象域/词汇色彩/禁用词倾向（≤400 字一段；与题材词表冲突时词表优先并呈报——词表唯一源红线）"
        },
        "syntax_patterns": {
          "type": "array",
          "maxItems": 5,
          "items": {"type": "string", "minLength": 1, "maxLength": 300},
          "description": "句长节奏（短句连击/长短配比）/句首模式/从句习惯/对话引导句式（每条可核对）"
        },
        "punctuation_habits": {
          "type": "array",
          "maxItems": 5,
          "items": {"type": "string", "minLength": 1, "maxLength": 300},
          "description": "破折号/省略号/感叹号/顿号罗列等标点习惯——每条写成可被指纹规则核对的形态（「感叹号每千字 ≤1，只在情绪顶点」优于「少用感叹号」）"
        },
        "structure_preferences": {
          "type": "array",
          "maxItems": 5,
          "items": {"type": "string", "minLength": 1, "maxLength": 300},
          "description": "网文化章节级结构偏好：章首钩子形态/场景切换手法/章尾收束与钩子留法/节奏蓄放（非文章结构）"
        },
        "dialogue_style": {
          "type": "array",
          "maxItems": 5,
          "items": {"type": "string", "minLength": 1, "maxLength": 300},
          "description": "对话风格：引导句式/对话与叙述配比/台词差异化手法"
        }
      },
      "description": "风格 DNA：七字段回答「他怎么想」，本字段回答「他写出来什么样」。四列表是可测/可核对的写作事实，不是偏好声明；tier=C/D 时列表为推导缺省或留空，须在 corpus_basis.notes 显式声明"
    },
    "measured_feature_list": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature", "metric", "value", "source", "source_ref"],
        "properties": {
          "feature": {
            "type": "string",
            "pattern": "^(fpr:[A-Za-z0-9]+|style:[a-z0-9-]+)$",
            "description": "fpr:=预筛指纹规则号（裁-1 统一命名空间，D2 冻结契约 fpr:L01 式大写编码；豁免查表键）；style:=风格侧测量特征（无机器核对通道=弱豁免，reviewer 引用须附人工抽样依据）"
          },
          "metric": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "description": "度量定义（如：每千字破折号数）"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "声明区间或档位（如 3-6）——豁免按区间比对，出区间即不豁免；点值不可信"
          },
          "source": {
            "enum": ["user_corpus", "authorized_text", "library_persona", "degraded_default"],
            "description": "依据分级，与 corpus_basis.tier 对应；tier=D 时本数组必须为空（allOf 强制）"
          },
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "溯源：resource:stylecorpus:xxx / styleseed 种子卡 resource id / 授权标识——红方 F11：逐条强制，溯源链不可断"
          },
          "notes": {
            "type": "string",
            "maxLength": 300,
            "description": "可选补充（测量口径/归一化基准说明）"
          }
        }
      },
      "description": "逐特征豁免依据（红方 F9 分层：fpr: 机器可核=强豁免；style: 语义核对=弱豁免）。只量写法不量内容——具体情节/观点/专有名词禁入；禁止「整体风格豁免」式条目；豁免条目变更列入 G1 回归触发事件"
    },
    "non_empty_text_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "\\S"
      }
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narrative", "anchors"],
      "properties": {
        "narrative": {
          "type": "string",
          "minLength": 200,
          "maxLength": 2000,
          "description": "300-500 字连贯人格叙事：五维生平织入，含目光/执念来路/自觉的内在矛盾"
        },
        "anchors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_sketch",
            "five_dimensions",
            "trait_profile",
            "theme_orientation",
            "inner_tension",
            "voice_samples",
            "blindspots"
          ],
          "properties": {
            "profile_sketch": {
              "type": "string",
              "minLength": 8,
              "maxLength": 200,
              "description": "一句生平定位"
            },
            "five_dimensions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "generation_age",
                "education_horizon",
                "class_circle_inventory",
                "career_track",
                "life_trajectory"
              ],
              "properties": {
                "generation_age": {"type": "string", "minLength": 2, "maxLength": 300},
                "education_horizon": {"type": "string", "minLength": 2, "maxLength": 300},
                "class_circle_inventory": {"type": "string", "minLength": 2, "maxLength": 300},
                "career_track": {"type": "string", "minLength": 2, "maxLength": 300},
                "life_trajectory": {"type": "string", "minLength": 2, "maxLength": 300}
              }
            },
            "trait_profile": {
              "type": "array",
              "minItems": 3,
              "maxItems": 5,
              "items": {"type": "string", "minLength": 8, "maxLength": 300},
              "description": "特质层（人格三层之特质）：每维必须行为化——抽象形容词不合格，须能指认具体行为/习惯"
            },
            "theme_orientation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dominant", "evidence"],
              "properties": {
                "dominant": {
                  "enum": ["agency", "communion", "dual"],
                  "description": "人生叙事的动机主题主导：agency=自主/成就/掌控；communion=联结/归属/关系；双低（疏离叙事）不允许出现，须重做"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 8,
                  "maxLength": 300,
                  "description": "主导倾向的行为证据"
                }
              }
            },
            "inner_tension": {
              "type": "string",
              "minLength": 8,
              "maxLength": 300,
              "description": "他自觉保留的内在矛盾——风格发动机，不许消解"
            },
            "voice_samples": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {"type": "string", "minLength": 4, "maxLength": 200}
            },
            "blindspots": {
              "type": "object",
              "additionalProperties": false,
              "required": ["refuses", "cannot_write"],
              "properties": {
                "refuses": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "items": {"type": "string", "minLength": 4, "maxLength": 300},
                  "description": "拒绝写：价值观上不屑的写法/题材，每条可追溯恐惧或创伤来源"
                },
                "cannot_write": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "items": {"type": "string", "minLength": 4, "maxLength": 300},
                  "description": "写不了：库存空白（没接触过的圈子/行当/暗面）——对全知全能的限制器，必须非空"
                }
              }
            }
          }
        }
      }
    }
  }
}
